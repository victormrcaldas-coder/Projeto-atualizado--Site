+   var q = QUOTES.filter(function(x){ return x.author===m[0] && x.text.indexOf(m[1])===0; })[0];
+   if(q){ q.src = m[2]; if(m[3]) q.notaAutoria = m[3]; }
+  });
+  console.log('MeMotiva · Fase 110: +'+nQ+' frases.');
