+   var id = 'f110'+idx.toString(36)+Math.abs((r[1].length*2654435761)%999983).toString(36);
+   while(qids[id]) id += 'x';
+   qids[id]=1;
+   var q = { author:r[0], text:r[1], src:r[5], st:'A', cat: cats.indexOf(r[4])>=0 ? r[4] : 'reflexao', qid:id, notaAutoria:r[6], notaInterna:r[7] };
+   if(r[2]) q.orig = r[2];
